import sys
import os
import argparse
import torch
from ultralytics import YOLO


def main():
    parser = argparse.ArgumentParser(
        description="Detect objects in images using YOLO11."
    )
    parser.add_argument(
        "image",
        nargs="?",
        help="Path to the input image"
    )
    parser.add_argument(
        "-t", "--threshold",
        type=float,
        default=0.25,
        help="Minimum confidence threshold (0.0 to 1.0)"
    )

    args = parser.parse_args()

    if not 0.0 <= args.threshold <= 1.0:
        print("Error: threshold must be between 0 and 1.",
              file=sys.stderr)
        return 1

    image_path = args.image

    if image_path is None:
        if sys.stdin.isatty():
            print("Error: no image path provided.", file=sys.stderr)
            return 1


        image_path = sys.stdin.readline().strip()

    if not image_path:
        print("Error: no image path provided.", file=sys.stderr)
        return 1

    if not os.path.isfile(image_path):
        print("Error: image file not found.", file=sys.stderr)
        return 1

    try:
        device = 0 if torch.cuda.is_available() else "cpu"
        model = YOLO("yolo11n.pt")

        results = model(
            image_path,
            conf=args.threshold,
            device=device,
            verbose=False
        )

        counts = {}

        for result in results:
            for box in result.boxes:
                class_id = int(box.cls[0])
                name = result.names[class_id]
                counts[name] = counts.get(name, 0) + 1

        print("YOLO Object Detection Results")
        print("-----------------------------")

        total = 0
        for name in sorted(counts):
            print(f"{name}: {counts[name]}")
            total += counts[name]

        print(f"Total objects: {total}")

        return 0

    except Exception as error:
        print(f"Error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())

